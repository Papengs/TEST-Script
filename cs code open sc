--================ FORMAT =================--

local function formatPrice(n)
	if not n or n == 0 then return "Harga ?" end
	local s = tostring(math.floor(n))
	local out, len = "", #s
	for i = 1, len do
		if i > 1 and (len-i+1) % 3 == 0 then out = out.."," end
		out = out..s:sub(i,i)
	end
	return "$"..out
end

local function getDist(pos)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return 9999 end
	return math.floor((root.Position - pos).Magnitude)
end

--================ FETCH HARGA DARI SERVER =================--

-- Ambil data bargain dari NPC Dealer
-- NPC punya NumberValue "Id" = Car Instance Id di server
local function fetchPriceFromNPC(npcModel)
	if not GetBargainData then return nil end
	local idVal = npcModel:FindFirstChild("Id")
	if not idVal then return nil end
	local ok, result = pcall(function()
		return GetBargainData:InvokeServer(npcModel)
	end)
	if ok and type(result) == "table" then
		-- Coba berbagai field harga yang umum
		return result.Price or result.AskingPrice or result.Cost
			or result.price or result.askingPrice or result.cost
			or result.Value or result.value or nil
	end
	return nil
end

-- Ambil harga dari slot mobil langsung
local function fetchPriceFromSlot(slotCar)
	if not GetBargainData then return nil end
	local ok, result = pcall(function()
		return GetBargainData:InvokeServer(slotCar)
	end)
	if ok and type(result) == "table" then
		return result.Price or result.AskingPrice or result.Cost
			or result.price or result.askingPrice or result.cost
			or result.Value or result.value or nil
	end
	-- Coba market remote juga
	if GetBargainDataMarket then
		local ok2, result2 = pcall(function()
			return GetBargainDataMarket:InvokeServer(slotCar)
		end)
		if ok2 and type(result2) == "table" then
			return result2.Price or result2.AskingPrice or result2.Cost
				or result2.price or result2.askingPrice or result2.cost
				or result2.Value or result2.value or nil
		end
	end
	return nil
end

-- Coba baca harga dari value/attribute di slotCar
local PRICE_KEYS = {"Price","AskingPrice","CarPrice","Cost","Value","SellPrice","Amount"}

local function getPriceLocal(obj)
	for _, key in ipairs(PRICE_KEYS) do
		local v = obj:FindFirstChild(key, true)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) and v.Value >= 100 then
			return v.Value
		end
	end
	for _, key in ipairs(PRICE_KEYS) do
		local a = obj:GetAttribute(key)
		if type(a) == "number" and a >= 100 then return a end
	end
	return nil
end

--================ SCAN SLOTS =================--

-- Nama container yang mungkin ada di berbagai game
local SLOT_CONTAINER_NAMES = {
	"Slots","Cars","Vehicles","SpawnedCars","OwnedCars",
	"CarSlots","Showroom","Dealership","Map","World",
	"NPCCars","StreetCars","DealerCars","ActiveCars",
}

local function isCarModel(obj)
	if not obj:IsA("Model") then return false end
	if isPlayerChar(obj) then return false end
	if obj:FindFirstChildOfClass("Humanoid") then return false end
	-- Harus punya minimal beberapa BasePart
	local count = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("MeshPart") then
			count = count + 1
			if count >= 3 then return true end
		end
	end
	return false
end

local function scanSlots()
	local results = {}
	local seen = {}

	local function addCar(child, slotName)
		if seen[child] then return end
		seen[child] = true
		local part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
		if part then
			local price = getPriceLocal(child) or 0
			table.insert(results, {
				model    = child,
				name     = child.Name,
				slotName = slotName or "World",
				price    = price,
				pos      = part.Position,
			})
		end
	end

	-- 1. Scan Workspace.Slots (struktur utama game ini)
	local slots = Workspace:FindFirstChild("Slots")
	if slots then
		for _, slot in ipairs(slots:GetChildren()) do
			for _, child in ipairs(slot:GetChildren()) do
				if isCarModel(child) then
					addCar(child, slot.Name)
				end
			end
			-- Slot sendiri bisa jadi model mobil
			if isCarModel(slot) then
				addCar(slot, "Slots")
			end
		end
	end

	-- 2. Scan container lain di workspace (neighbourhood, jalanan, dll)
	for _, containerName in ipairs(SLOT_CONTAINER_NAMES) do
		local container = Workspace:FindFirstChild(containerName)
		if container and container ~= slots then
			for _, obj in ipairs(container:GetDescendants()) do
				if isCarModel(obj) then
					addCar(obj, containerName)
				end
			end
		end
	end

	-- 3. Scan seluruh workspace top-level (tangkap mobil yang tidak dalam folder khusus)
	for _, obj in ipairs(Workspace:GetChildren()) do
		if isCarModel(obj) then
			addCar(obj, "Workspace")
		end
	end

	return results
end

-- Scan NPC Dealer di workspace
local function isPlayerChar(obj)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character == obj then return true end
	end
	return false
end

local function scanDealerNPCs()
	local results = {}
	local seen = {}
	local function recurse(parent)
		for _, obj in ipairs(parent:GetChildren()) do
			if seen[obj] then continue end
			seen[obj] = true
			if obj:IsA("Model") and not isPlayerChar(obj) then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				if hum then
					local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
					local idVal = obj:FindFirstChild("Id")
					if root and (idVal or obj.Name:lower():find("dealer")) then
						table.insert(results, {
							model  = obj,
							name   = obj.Name,
							pos    = root.Position,
							carId  = idVal and idVal.Value or nil,
						})
					end
				else
					recurse(obj)
				end
			elseif obj:IsA("Folder") then
				recurse(obj)
			end
		end
	end
	recurse(Workspace)
	return results
end

--================ MAIN SCAN + FETCH =================--

local statusL -- forward declare

local function fullScan(onDone)
	-- 1. Scan slot mobil
	local slotCars = scanSlots()
	-- 2. Scan NPC dealer
	local npcs = scanDealerNPCs()

	local results = {}

	-- Pasangkan NPC ke slot terdekat, ambil harga via remote
	local usedNPC = {}
	for _, car in ipairs(slotCars) do
		local bestNPC, bestDist = nil, 150 -- radius max 150 studs (diperluas)
		for _, npc in ipairs(npcs) do
			if not usedNPC[npc] then
				local d = (car.pos - npc.pos).Magnitude
				if d < bestDist then
					bestDist = d
					bestNPC = npc
				end
			end
		end

		local price = car.price
		-- Fetch dari remote kalau belum dapat harga
		if price == 0 and bestNPC then
			local fetched = fetchPriceFromNPC(bestNPC)
			if fetched then price = fetched; usedNPC[bestNPC] = true end
		end
		if price == 0 then
			local fetched = fetchPriceFromSlot(car.model)
			if fetched then price = fetched end
		end

		table.insert(results, {
			model    = car.model,
			name     = car.name,
			slotName = car.slotName,
			price    = price or 0,
			pos      = car.pos,
			npc      = bestNPC,
		})
	end

	-- Kalau tidak ada slot, fallback ke NPC saja
	if #results == 0 then
		for _, npc in ipairs(npcs) do
			local price = fetchPriceFromNPC(npc) or 0
			table.insert(results, {
				model    = npc.model,
				name     = npc.name,
				slotName = "NPC",
				price    = price,
				pos      = npc.pos,
				npc      = npc,
			})
		end
	end

	-- Sort harga tertinggi
	table.sort(results, function(a,b) return a.price > b.price end)
	if onDone then onDone(results) end
	return results
end

