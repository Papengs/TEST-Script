--================ AUTO TP =================--

local autoTPIndex = 1 -- cycling index untuk auto TP

local function doAutoTP()
	-- Kumpulkan semua mobil yang memenuhi filter harga
	local eligible = {}
	for _, car in ipairs(carList) do
		if car.price >= minPrice then
			table.insert(eligible, car)
		end
	end
	if #eligible == 0 then return end

	-- Cycle ke mobil berikutnya
	if autoTPIndex > #eligible then autoTPIndex = 1 end
	local car = eligible[autoTPIndex]
	autoTPIndex = autoTPIndex + 1

	local char = player.Character
	if char then
		char:PivotTo(CFrame.new(car.pos + Vector3.new(2,5,2)))
		statusL.Text = string.format("🤖 Auto TP [%d/%d]: %s | %s", autoTPIndex-1, #eligible, car.name, formatPrice(car.price))
	end
end

autoBtn.MouseButton1Click:Connect(function()
	autoTP = not autoTP
	if autoTP then
		autoBtn.Text = "🤖 Auto TP: ON"
		autoBtn.BackgroundColor3 = Color3.fromRGB(0,140,0)
		autoTPThread = task.spawn(function()
			while autoTP do
				doAutoTP()
				task.wait(4)
			end
		end)
		doAutoTP()
	else
		autoTP = false
		autoBtn.Text = "🤖 Auto TP: OFF"
		autoBtn.BackgroundColor3 = Color3.fromRGB(130,0,0)
		autoTPIndex = 1
	end
end)

