local function findLocationCF(keywords)
	-- 1. Cari di TeleportLocations folder
	local tpFolder = Workspace:FindFirstChild("TeleportLocations")
	if tpFolder then
		for _, loc in ipairs(tpFolder:GetChildren()) do
			for _, kw in ipairs(keywords) do
				if loc.Name:lower():find(kw) then return loc.CFrame end
			end
		end
	end
	-- 2. Scan seluruh workspace lebih dalam (depth 4)
	local function searchDeep(parent, depth)
		if depth > 4 then return nil end
		for _, obj in ipairs(parent:GetChildren()) do
			if obj:IsA("BasePart") or obj:IsA("SpawnLocation") or obj:IsA("Part") then
				for _, kw in ipairs(keywords) do
					if obj.Name:lower():find(kw) then return obj.CFrame end
				end
			end
			if obj:IsA("Model") or obj:IsA("Folder") then
				for _, kw in ipairs(keywords) do
					if obj.Name:lower():find(kw) then
						local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
						if part then return part.CFrame end
					end
				end
				local found = searchDeep(obj, depth+1)
				if found then return found end
			end
		end
		return nil
	end
	return searchDeep(Workspace, 0)
end

